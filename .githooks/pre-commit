#!/bin/sh
#
# Formats staged Swift files with swift-format before the commit lands.
#
# Enable with ./Scripts/bootstrap.sh (sets core.hooksPath to .githooks). Git never
# runs hooks straight from a clone, so this is opt-in per clone — CI runs
# `swift format lint --strict` as the backstop for anyone who skips it.
#
# Files that have BOTH staged and unstaged changes are skipped: formatting them in
# place and re-staging would sweep the unstaged work-in-progress hunks into the
# commit. Silently committing unstaged work is worse than an unformatted line.

set -eu

staged=$(git diff --cached --name-only --diff-filter=ACMR -- '*.swift')
[ -n "$staged" ] || exit 0

unstaged=$(git diff --name-only -- '*.swift')

to_format=""
for file in $staged; do
    [ -f "$file" ] || continue

    skip=0
    for dirty in $unstaged; do
        if [ "$file" = "$dirty" ]; then
            skip=1
            break
        fi
    done

    if [ "$skip" -eq 1 ]; then
        echo "pre-commit: skipping $file (has unstaged changes) — run 'swift format --in-place $file' yourself" >&2
    else
        to_format="$to_format $file"
    fi
done

[ -n "$to_format" ] || exit 0

# shellcheck disable=SC2086
swift format --in-place --parallel $to_format
# shellcheck disable=SC2086
git add $to_format
