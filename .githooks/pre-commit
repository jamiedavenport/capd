#!/bin/bash
#
# Formats staged Swift files with swift-format before the commit lands.
#
# Enable with ./Scripts/bootstrap.sh (sets core.hooksPath to .githooks). Git never
# runs hooks straight from a clone, so this is opt-in per clone — CI runs
# `swift format lint --strict` as the backstop for anyone who skips it.
#
# Files that have BOTH staged and unstaged changes are skipped: formatting them in
# place and re-staging would sweep the unstaged work-in-progress hunks into the
# commit. Silently committing unstaged work is worse than an unformatted line.
#
# Paths are read NUL-delimited and always quoted. Word-splitting them would break
# on a path containing whitespace, and glob-expanding them could make the `git add`
# below stage files the user never staged — the exact failure this hook exists to
# prevent.

set -eu

to_format=()
while IFS= read -r -d '' file; do
    [ -f "$file" ] || continue

    if ! git diff --quiet -- "$file"; then
        echo "pre-commit: skipping $file (has unstaged changes) — format it yourself with 'swift format --in-place'" >&2
        continue
    fi

    to_format+=("$file")
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.swift')

[ "${#to_format[@]}" -gt 0 ] || exit 0

swift format --in-place --parallel -- "${to_format[@]}"
git add -- "${to_format[@]}"
